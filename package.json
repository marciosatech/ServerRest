{
  "name": "serverest-login-validations",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests/api",
    "test:e2e": "playwright test tests/e2e",
    "test:headed": "playwright test --headed",
    "test:login": "playwright test tests/e2e/login.e2e.spec.ts",
    "gerar:resumo": "node scripts/gerar-resumo-testes.mjs",
    "verificar:tipos": "tsc --noEmit",
    "allure:limpar": "node -e \"require('node:fs').rmSync('allure-results',{recursive:true,force:true})\"",
    "allure:gerar": "allure generate allure-results --clean -o allure-report --name \"ServeRest - Automação de testes\"",
    "allure:abrir": "allure open allure-report",
    "allure:servir": "allure serve allure-results --name \"ServeRest - Automação de testes\""
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "typescript": "^5.9.0"
  }
}
